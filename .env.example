# Supabase: Dashboard -> Connect -> "Session pooler" connection string.
# (The "Direct connection" host is IPv6-only and fails on most home networks.)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Summaries: "ollama" (local, free; the default) or "anthropic" (Claude, paid per token).
SUMMARY_PROVIDER=ollama

# Ollama settings (only used when SUMMARY_PROVIDER=ollama).
# Install with: ollama pull qwen2.5:14b  (about 9 GB; needs ~16 GB of memory)
OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_HOST=http://localhost:11434
# Context window in tokens. Bigger fits longer staff reports but uses more memory.
# OLLAMA_NUM_CTX=16384

# Only needed when SUMMARY_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Email alerts (python -m pipeline.alerts). Use a Gmail address with 2-Step Verification on, and an
# app password from https://myaccount.google.com/apppasswords (16 letters).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The website's public address, for links in emails (no trailing slash).
SITE_URL=http://localhost:3000
