# Supabase dashboard -> Project Settings -> API (or Connect -> Framework).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The public "anon" / "publishable" key. Safe in the browser: the database only allows reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where "Report an error" links send email. The link is hidden if this is empty.
NEXT_PUBLIC_REPORT_EMAIL=
