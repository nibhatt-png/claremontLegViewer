# Supabase dashboard -> Project Settings -> API (or Connect -> Framework).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The public "anon" / "publishable" key. Safe in the browser: the database only allows reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where "Report an error" links send email. The link is hidden if this is empty.
NEXT_PUBLIC_REPORT_EMAIL=

# Email alerts sign-up. Leave these empty to keep alerts switched off.
# Supabase -> Project Settings -> API Keys -> "secret" key (or the legacy service_role key).
# Server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Same Gmail address and app password as the pipeline's .env.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The site's public address, for links in confirmation emails. Optional locally.
SITE_URL=
